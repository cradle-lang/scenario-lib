# Optional LLM generation only. Manual index.md authoring needs no .env.
# Copy this file to .env beside package.json and enter your own key locally.
# The example uses the soclaas remote LLM server, which is free for NUS students and staff. 
# You can also use your own OpenAI key or a local LLM model.
# Remote Server
#CTI_LLM_PROVIDER=Remote-Server
SERVER="https://soclaas-api.comp.nus.edu.sg/v1"
REMOTE_LLM_MODEL="qwen3.6:35b"
REMOTE_LLM_API_KEY=""

# Optional OpenAI mode: leave SERVER empty and set these instead.
#CTI_LLM_PROVIDER=OpenAi
# OPENAI_API_KEY=""
#OPENAI_MODEL="gpt-5.4-nano"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Local LLM
#CTI_LLM_PROVIDER=Local-LLM
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# Input is bounded; image/binary contents are not sent.
LLM_MAX_INPUT_CHARS=100000
