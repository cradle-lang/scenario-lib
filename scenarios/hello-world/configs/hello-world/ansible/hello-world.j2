    - name: Create the Hello World directory
      ansible.builtin.file:
        path: /opt/cradle/hello-world
        state: directory
        owner: root
        group: root
        mode: "0755"

    - name: Write the provisioning marker
      ansible.builtin.copy:
        dest: /opt/cradle/hello-world/ready.txt
        content: |
          CRADLE Hello World
          scenario=hello-world
        owner: root
        group: root
        mode: "0644"

