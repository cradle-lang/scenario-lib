    - name: Create railway-physical-world-simulator role directory
      ansible.windows.win_file:
        path: 'C:\Railway\roles\physical-world'
        state: directory

    - name: Install railway-physical-world-simulator files
      ansible.windows.win_copy:
        src: "{{ config_asset_dir }}/files/"
        dest: 'C:\Railway\roles\physical-world\'

    - name: Install railway-physical-world-simulator launcher
      ansible.windows.win_copy:
        content: |
          @echo off
          set "PYTHONPATH=C:\Railway\lib;C:\Railway\runtime"
          cd /d "C:\Railway\roles\physical-world"
          "C:\ProgramData\cxc\python\python.exe" "C:\Railway\roles\physical-world\RailwayPWSimuRun.py"
        dest: 'C:\Railway\roles\physical-world\run.cmd'

    - name: Register and start railway-physical-world-simulator
      ansible.windows.win_shell: |
        $taskName = "Railway-physical-world"
        $action = New-ScheduledTaskAction -Execute "cmd.exe" `
          -Argument '/c "C:\Railway\roles\physical-world\run.cmd"' -WorkingDirectory 'C:\Railway\roles\physical-world'
        $trigger = New-ScheduledTaskTrigger -AtStartup
        $principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" `
          -LogonType ServiceAccount -RunLevel Highest
        $settings = New-ScheduledTaskSettingsSet -RestartCount 999 `
          -RestartInterval (New-TimeSpan -Minutes 1) `
          -ExecutionTimeLimit (New-TimeSpan -Days 365)
        Stop-ScheduledTask -TaskName $taskName -ErrorAction SilentlyContinue
        Unregister-ScheduledTask -TaskName $taskName -Confirm:$false `
          -ErrorAction SilentlyContinue
        Register-ScheduledTask -TaskName $taskName -Action $action `
          -Trigger $trigger -Principal $principal -Settings $settings -Force | Out-Null
        Start-ScheduledTask -TaskName $taskName
        Start-Sleep -Seconds 3

    - name: Verify railway-physical-world-simulator network port
      ansible.windows.win_shell: |
        $deadline = (Get-Date).AddSeconds(60)
        while ((Get-Date) -lt $deadline) {
          if (Get-NetUDPEndpoint -LocalPort 3001 -ErrorAction SilentlyContinue) {
            exit 0
          }
          Start-Sleep -Seconds 2
        }
        throw "Railway railway-physical-world-simulator port 3001 did not open"
