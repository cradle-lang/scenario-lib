    - name: Create railway-plc-simulator-train role directory
      ansible.builtin.file:
        path: /opt/railway/roles/plc-train
        state: directory
        mode: "0755"
      become: yes

    - name: Install railway-plc-simulator-train files
      ansible.builtin.copy:
        src: "{{ config_asset_dir }}/files/"
        dest: /opt/railway/roles/plc-train/
        mode: preserve
      become: yes

    - name: Install railway-plc-simulator-train systemd service
      ansible.builtin.copy:
        content: |
          [Unit]
          Description=Railway railway-plc-train
          After=network-online.target
          Wants=network-online.target

          [Service]
          Type=simple
          User=root
          WorkingDirectory=/opt/railway/roles/plc-train
          Environment=PYTHONPATH=/opt/railway/lib:/opt/railway/runtime
          ExecStart=/usr/bin/python3 /opt/railway/roles/plc-train/plcSimulatorTrain.py
          Restart=on-failure
          RestartSec=5

          [Install]
          WantedBy=multi-user.target
        dest: /etc/systemd/system/railway-plc-train.service
        mode: "0644"
      become: yes

    - name: Start railway-plc-simulator-train
      ansible.builtin.systemd:
        name: railway-plc-train
        enabled: yes
        state: restarted
        daemon_reload: yes
      become: yes

    - name: Verify railway-plc-simulator-train network port
      ansible.builtin.wait_for:
        host: 127.0.0.1
        port: 504
        timeout: 60
